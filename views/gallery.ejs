<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Ilja Artjomenko, veebiprogrammeerimine</title>
	<link rel="stylesheet" href="/style/gallery.css">
	<script scr="/script/gallery.ks" defer</script>
</head>
<body>
	<img src="../pic/veebiprogrammeerimine_2026_TA.png" alt="">
	<h1>Fotogalerii</h1>
	<hr>
	<ul>
		<li><a href="/">Avalehele</a></li>
	</ul>
	<hr>
	<dialog id="modal" class="modalarea">
		<span id="modalClose" class="modalclose">&times;</span>
		<div class="modalhorizontal">
			<div class="modalvertical">
				<p id="modalCaption"></p>
				<img id="modalImage" src="../Pictures/empty.png" alt="galeriipilt">
			</div>
		</div>
	</dialog>
	<div id="gallery" class="gallery">
		<% galleryData.forEach(function(image){ %>
		  <img src="<%=imagehref%><%=image.src%>" alt="<%=image.alt%>" class="thumbs" data-id="<%=image.id%>" data-filename="<%=image.src%>">
		<% }); %>
	</div>
</body>
</html>